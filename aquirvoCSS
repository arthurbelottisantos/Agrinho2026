body{
    font-family: Arial, sans-serif;
    background-color: #125e5b;
    margin: 0;
    padding: 20px;
}

p{
    font-size: 16px;
    color: #010101;
}

h1{
    font-size: 24px;
    color: #7CFC00;
    margin-top: 20px;
}

button{
    background-color: #4CAF50;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}


#btnModoEscuro:hover{
    background-color: #1b5e20;
}

.dark{
    background-color: #121212;
    color: white;
}

.dark .container{
    background-color: #1e1e1e;
}

.dark h1,
.dark h2{
    color: #7CFC00;
}

.dark p,
.dark label{
    color: white;
}

.dark button{
    background-color: #388E3C;
}

img.img {
    width: 350px;
    height: auto;
}